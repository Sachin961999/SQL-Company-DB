---------------------------------------------------------------------------SQL_Clauses-----------------------------------------------------------------------------------------------

-- WHERE

SELECT * from Employees WHERE Department = 'IT'                                                                                                                            Filtering

-- LIKE

select * from Employees where EmpName LIKE "A%";                                                                                        Starting "A%", Ending "%A", Anywhere "%ABC%"

-- ORDER BY

select * from employees where department = 'IT' order by hire_date DESC;                                                                                                     Sorting

-- AND / OR

SELECT * from Employees WHERE Department = 'IT' OR Department ='HR'                                                                              select multiple rows in same column

Select * from Employees where City = 'Delhi' and salary > 50000;                                                                                   It combine two or more conditions

-- IN

SELECT * from Employees WHERE Department IN ('IT','Sales','Finance')                                                                     It’s a shorthand for multiple OR conditions

-- NOT IN

SELECT * from Employees WHERE Department NOT IN ('IT','Sales','Finance')

-- BETWEEN

Select * from Employees where salary BETWEEN '50000' AND '70000';                                                                           Filter results within a range of a value

-- GROUP BY

select department, count(EmpName) as EMP_Count from employees group by department;

-- Having

SELECT department_id, COUNT(*) AS total_employees
FROM employees
GROUP BY department_id
HAVING COUNT(*) > 5;
