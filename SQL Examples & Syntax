------------------------------------------------------------------------------------CTAs--------------------------------------------------------------------------------------------

## CTAs :
 
-- It’s a SQL command used to create a new table and populate it with the results of a SELECT query.
-- Instead of manually defining columns and then inserting data, CTAS lets you build a table directly from an existing dataset.
-- It’s often used for backups, transformations, or staging data.

SYNTAX:

Create table NAME as
(SELECT...
 FROM...
 WHERE...)

EXAMPLE:

create table sachin as 
(select course_id,course_name 
from courses);

-------------------------------------------------------------------------------------VIEWS-------------------------------------------------------------------------------------------

## VIEWS :

-- A view is a virtual table based on the result of a SQL query.
-- It doesn’t store data itself; instead, it stores the query definition.
-- When you query a view, MySQL executes the underlying query and shows the results.
-- Views are useful for simplifying complex queries, improving security, and ensuring consistency.

SYNTAX:

CREATE VIEW view_name AS
SELECT column1, column2, ...
FROM table_name
WHERE condition;

EXAMPLE:

CREATE VIEW ShortlistedCandidates AS
SELECT CandidateID, Name, Score
FROM Candidates
WHERE Status = 'Shortlisted';

-----------------------------------------------------------------------STORE_Procedure-----------------------------------------------------------------------------------------------

## Store Procedure :

-- Definition: A stored procedure is a group of SQL statements bundled together and stored in the database.
-- Execution: Instead of writing the same query repeatedly, you call the procedure by name.
-- Flexibility: Procedures can accept input parameters and return output values, making them dynamic.

Syntax :

DELIMITER $$
CREATE PROCEDURE procedure_name ( [parameters] )
BEGIN
    -- SQL statements go here
END$$
DELIMITER ;

Example :

DELIMITER $$
CREATE PROCEDURE GetEmployeeDetails(IN emp_id INT)
BEGIN
    SELECT EmployeeID, EmployeeName, DepartmentID, Salary
    FROM Employees
    WHERE EmployeeID = emp_id;
END$$
DELIMITER ;

